{
  "name": "rekonvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "test:brand": "node scripts/verify-brand.mjs",
    "test:e2e:install": "node scripts/playwright.mjs install chromium --no-shell",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:auth": "node scripts/test-e2e.mjs --authenticated"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "docx": "9.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fflate": "0.8.3",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
